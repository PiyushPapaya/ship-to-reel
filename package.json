{
  "name": "reel-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eigene Video-Engine: aus Projekt (Website/GitHub/Brief) markenkonsistente Reels beliebiger Laenge.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reel": "bin/reel.mjs"
  },
  "scripts": {
    "validate": "node engine/validate.mjs",
    "test": "node engine/validate.mjs",
    "test:unit": "node --test engine/__tests__/*.test.mjs",
    "test:all": "npm run validate && npm run test:unit",
    "reel": "node bin/reel.mjs",
    "collect": "node engine/collect.mjs",
    "resolve-spec": "node engine/resolve-spec.mjs",
    "assemble": "node engine/assemble.mjs",
    "capture": "node engine/capture.mjs",
    "broll": "node engine/broll.mjs",
    "tts": "node engine/tts.mjs",
    "align-captions": "node engine/align-captions.mjs",
    "beat-sync": "node engine/beat-sync.mjs",
    "seam-gate": "node engine/seam-gate.mjs",
    "render": "node engine/render.mjs",
    "quality-check": "node engine/quality-check.mjs",
    "score-frames": "node engine/score-frames.mjs",
    "build": "node engine/assemble.mjs && node engine/seam-gate.mjs && node engine/align-captions.mjs && node engine/render.mjs",
    "distribution-copy": "node engine/generate-distribution-copy.mjs",
    "distribute": "node distribute/index.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "msedge-tts": "^2.0.7"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "playwright": "^1.62.1",
    "yaml": "^2.6.1"
  }
}
